# Production Environment Variables for cPanel Deployment
# Replace 'your-railway-app' with your actual Railway app URL
REACT_APP_API_URL=https://namasdeploy-production.up.railway.app/api
REACT_APP_SERVER_URL=https://namasdeploy-production.up.railway.app

# Build optimization
GENERATE_SOURCEMAP=false
BUILD_PATH=./build

# Ensure proper asset handling
PUBLIC_URL=.
REACT_APP_PUBLIC_URL=.

# CSS and asset loading optimization
INLINE_RUNTIME_CHUNK=false
REACT_APP_DEPLOYMENT_TARGET=production