# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/namas_architecture
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/namas_architecture

# Server Configuration
PORT=8080
NODE_ENV=development

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# CORS Configuration
ALLOWED_ORIGINS=https://www.namasbhutan.com,https://namasbhutan.com,http://localhost:3000

# Data Storage (fallback when MongoDB is not available)
DATA_DIR=/data
UPLOADS_DIR=/uploads
