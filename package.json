{
  "name": "namas-architecture",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "cors": "^2.8.5",
    "form-data": "^4.0.4",
    "lucide-react": "^0.525.0",
    "mongodb": "^6.20.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--no-deprecation react-scripts start",
    "build": "react-scripts build",
    "build:production": "env-cmd -f .env.production react-scripts build && cp public/.htaccess build/.htaccess && cp public/proxy-uploads.php build/proxy-uploads.php",
    "build:cpanel": "npm run build:production && npm run optimize:cpanel",
    "optimize:cpanel": "echo 'Build completed for cPanel deployment. Upload the build folder contents to your cPanel public_html directory.'",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
